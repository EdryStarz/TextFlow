<Window x:Class="TextFlow.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="390" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="#FF0C1017" Foreground="#FFF1F5FC" FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="Assets/textflow-icon-256.png" ShowInTaskbar="False" Topmost="True" KeyDown="Window_KeyDown">
  <Border Background="#FF151B26" BorderBrush="#FF44516A" BorderThickness="1" CornerRadius="14" Padding="12">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid>
        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" FontSize="16" Padding="14,10" />
        <TextBlock Text="Поиск всех фраз…" Foreground="#FF9EACC0" FontSize="16" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" x:Name="Placeholder" />
      </Grid>
      <ListBox x:Name="ResultList" Grid.Row="2" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
               Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonDown="ResultList_PreviewMouseLeftButtonDown" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="item" Padding="10,7" CornerRadius="8"><ContentPresenter /></Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="item" Property="Background" Value="#FF303A51" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="item" Property="Background" Value="#FF273145" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding KindLabel}" Foreground="#FFC4A8FF" FontSize="11" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FFF4F7FC" FontSize="13" />
                <TextBlock Text="{Binding Preview}" Foreground="#FFBAC6D9" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Border Grid.Column="2" Background="#33313D53" CornerRadius="4" Padding="7,3" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="{Binding Hotkey}" Foreground="#FFCDD8EA" FontSize="12" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <DockPanel Grid.Row="3" Margin="8,12,8,2">
        <TextBlock Text="Клик / Enter — вставить   •   Ctrl+E редактировать   •   Ctrl+N добавить" Foreground="#FFAAB8CE" FontSize="11" />
        <TextBlock DockPanel.Dock="Right" Text="Esc" Foreground="#FFC4A8FF" FontSize="11" FontWeight="SemiBold" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
