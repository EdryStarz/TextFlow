<Window x:Class="TextFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextFlow" Height="760" Width="1200" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen" Icon="Assets/textflow-icon-256.png"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" TextOptions.TextFormattingMode="Display">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FF151A24" BorderBrush="#FF283246" BorderThickness="1" CornerRadius="16" Padding="18,15">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="46" Height="46" Background="#FF242B3B" CornerRadius="12" Padding="5" VerticalAlignment="Center">
            <Image Source="/Assets/textflow-icon-256.png" Stretch="Uniform" />
          </Border>
          <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="TextFlow" FontSize="27" FontWeight="SemiBold" Foreground="#FFF5F7FC" />
            <TextBlock Text="Фразы, быстрые действия и поиск без переключения окон" Margin="0,3,0,0" Foreground="#FFAEBBD0" FontSize="13" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Click="Search_Click" Margin="0,0,8,0" ToolTip="Открыть палитру поиска">
            <StackPanel Orientation="Horizontal"><TextBlock Text="⌕  Поиск" /><TextBlock Text="{Binding SearchHotkey}" Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /></StackPanel>
          </Button>
          <Button Style="{StaticResource PrimaryButton}" Click="New_Click">＋ Новый</Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="370" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock Text="БИБЛИОТЕКА ФРАЗ" FontWeight="SemiBold" Foreground="#FFB6C5DD" FontSize="12" />
          <TextBox Grid.Row="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по названию, тексту или сочетанию" FontSize="14" />
          <ListBox Grid.Row="4" ItemsSource="{Binding FilteredSnippets}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,5" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="itemBorder" Padding="12,10" CornerRadius="8" Background="Transparent"><ContentPresenter /></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#553C4A62" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#332A3345" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FFF1F5FC" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Preview}" Foreground="#FFAFBED3" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="#332D3748" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Hotkey}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="28">
        <Grid DataContext="{Binding Selected}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="20" />
            <RowDefinition Height="Auto" /><RowDefinition Height="8" />
            <RowDefinition Height="Auto" /><RowDefinition Height="8" />
            <RowDefinition Height="Auto" /><RowDefinition Height="16" />
            <RowDefinition Height="Auto" /><RowDefinition Height="8" />
            <RowDefinition Height="*" /><RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" Foreground="#FFF6F8FC" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="2" Text="НАЗВАНИЕ" Foreground="#FFB6C5DD" FontSize="12" FontWeight="SemiBold" />
          <TextBox x:Name="TitleEditor" Grid.Row="4" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="15" />
          <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="ТИП ДЕЙСТВИЯ" Foreground="#FFB6C5DD" FontSize="12" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Click="TextKind_Click" Padding="12,7">Текст</Button>
                <Button Click="LaunchKind_Click" Margin="8,0,0,0" Padding="12,7">Запуск</Button>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="ГОРЯЧАЯ КЛАВИША" Foreground="#FFB6C5DD" FontSize="12" FontWeight="SemiBold" />
              <ComboBox x:Name="HotkeySelector" Margin="0,8,0,0" FontSize="14" IsEditable="False"
                        ItemsSource="{Binding DataContext.HotkeyOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                        SelectedValuePath="Value" SelectedValue="{Binding Hotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectionChanged="HotkeySelector_SelectionChanged"
                        ToolTip="Выберите сочетание. Занятые варианты откроют список фраз.">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Display}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="8">
            <TextBlock Text="ТЕКСТ ИЛИ ПУТЬ / КОМАНДА" Foreground="#FFB6C5DD" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="Поддерживаются tab, Enter, буфер обмена, дата и время QuickTextPaste." Foreground="#FF8F9EB5" FontSize="12" Margin="0,5,0,0" />
          </StackPanel>
          <TextBox x:Name="ContentEditor" Grid.Row="10" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" FontSize="15" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
          <Grid Grid.Row="12">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Click="Delete_Click" Foreground="#FFFF9CA5">Удалить</Button>
            <Button Grid.Column="1" Click="Import_Click">Импорт QuickTextPaste.ini</Button>
            <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Click="Save_Click">Сохранить изменения</Button>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <DockPanel Grid.Row="3" Margin="3,14,3,0">
      <TextBlock Text="{Binding Status}" Foreground="#FFB6C5DD" FontSize="12" />
      <TextBlock DockPanel.Dock="Right" Text="Ctrl+E — редактировать из палитры  •  Ctrl+N — добавить" Foreground="#FF8F9EB5" FontSize="12" />
    </DockPanel>
  </Grid>
</Window>
